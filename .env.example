APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# sqlite is the default for local/offline development.
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/mathios.db
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20

# Use postgres in Docker or hosted deployments.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgres://mathios:mathios@localhost:5432/mathios

STORAGE_PROVIDER=local
STORAGE_ROOT=./data/storage
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_SIGNED_URL_TTL_SECONDS=900

# S3-compatible storage (required for APP_ENV=hosted-production).
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=mathios-production
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false

# Hosted auth verifies Authorization: Bearer JWT tokens with HS256 or RS256.
AUTH_MODE=local-profile
# HOSTED_AUTH_ISSUER=https://issuer.example.com/
# HOSTED_AUTH_AUDIENCE=mathios
# HOSTED_AUTH_SHARED_SECRET=
# HOSTED_AUTH_PUBLIC_KEY=

SEARCH_PROVIDER=local
AI_PROVIDER=disabled
AI_LOCAL_BASE_URL=http://127.0.0.1:11434
AI_LOCAL_MODEL=llama3.2
AI_REMOTE_BASE_URL=https://api.openai.com/v1
AI_REMOTE_MODEL=gpt-4o-mini
# Optional server-only fallback key; the AI settings screen stores keys encrypted instead.
# AI_REMOTE_API_KEY=
AI_REQUEST_TIMEOUT_MS=15000

# Development fallback only. Replace with a random 32+ character secret outside local development.
SESSION_SECRET=change-me-in-development-only-change-me
SESSION_ROTATION_INTERVAL_SECONDS=86400
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
CSRF_PROTECTION_ENABLED=true
TRUST_PROXY=false
# ERROR_TRACKING_DSN=https://errors.example.com/api/events
# METRICS_TOKEN=
LOG_LEVEL=info
